# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from your Supabase project:
# Dashboard -> Project Settings -> API

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Project ID (e.g. xyzcompany)
SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Anon / Publishable Key (safe for client-side)
# Accepts both 'sb_publishable_...' and JWT format 'eyJ...'
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Supabase Service Role Key (Secret backend key - keep private)
# Used on server for creating signed download URLs and admin operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional: Covalent API Key (for automatic on-chain payment verification)
# COVALENT_API_KEY=""
